{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacleaner.local/plan.schema.json",
  "title": "Cleaning plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "generated_by",
    "source_columns",
    "actions"
  ],
  "properties": {
    "plan_version": {
      "const": 1
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt_version"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "source_columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "column",
        "action",
        "params",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "cast",
            "fillna",
            "regex_replace",
            "drop",
            "strip",
            "datetime_parse",
            "clip"
          ]
        },
        "params": {
          "type": "object"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "cast"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/cast_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "fillna"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/fillna_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "regex_replace"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/regex_replace_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "drop"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/drop_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "strip"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/strip_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "datetime_parse"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/datetime_parse_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "clip"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/clip_params"
              }
            }
          }
        }
      ]
    },
    "cast_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to"
      ],
      "properties": {
        "to": {
          "enum": [
            "int",
            "float",
            "str",
            "bool"
          ]
        }
      }
    },
    "fillna_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "constant",
            "mean",
            "median",
            "mode"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "if": {
        "properties": {
          "strategy": {
            "const": "constant"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "required": [
          "value"
        ]
      },
      "else": {
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    "regex_replace_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "replacement"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "replacement": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "strip_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case"
      ],
      "properties": {
        "case": {
          "enum": [
            "none",
            "lower",
            "upper",
            "title"
          ]
        }
      }
    },
    "datetime_parse_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(%[YmdHMSbByj]|[-/ .:T,])+$"
        }
      }
    },
    "clip_params": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "drop_params": {
      "type": "object",
      "maxProperties": 0
    }
  }
}
